# Salin hanya bila .env belum ada:  test -f .env || cp .env.example .env
# Lalu ganti setiap placeholder dengan nilai lokalmu sendiri.
# Jangan menimpa .env asli dan jangan commit file .env.
#
# Pengembangan lokal. MySQL lokal: 127.0.0.1:3307, dua database terpisah.
# Persen-encode karakter khusus bila password mengandung : / @ ? # atau %.
DATABASE_URL=mysql+pymysql://wad05_dev:GANTI_PASSWORD_DEV@127.0.0.1:3307/wad05_dev?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://wad05_test:GANTI_PASSWORD_TEST@127.0.0.1:3307/wad05_test?charset=utf8mb4
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
#
# Kontainer produksi memakai komponen berikut, bukan DATABASE_URL. Password
# diberikan saat runtime oleh operator (secret manager), tidak disimpan di sini.
# DB_USER=wad05_app
# DB_PASSWORD=<diisi-saat-runtime>
# DB_NAME=wad05
# CLOUDSQL_CONNECTION_NAME=<project>:<region>:<instance>
# ENVIRONMENT=production
# ALLOWED_ORIGINS=["https://<host-layanan>"]
# FRONTEND_DIR=/app/dist
# ENABLE_API_DOCS=false
#
# Password penjual untuk perintah seed eksplisit. Jangan isi dengan kredensial
# nyata; untuk lokal gunakan password fixture/uji milikmu sendiri.
# SEED_SELLER_PASSWORD=<password-lokal>
